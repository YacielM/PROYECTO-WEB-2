//- views/admisiones/editar.pug
extends ../layout.pug

block content
  .container.mt-4
    h1.text-center Editar Admisión
    .card.shadow
      .card-body
        //- Mensaje de error si algo falla en el controlador
        if error
          .alert.alert-danger= error

        //- Formulario principal para editar admisión existente
        form(action=`/admisiones/editar/${admision.id}` method="POST")
          h5 Datos del Paciente
          .row.g-3
            //- Paciente mostrado en solo lectura
            .col-md-6
              label.form-label Paciente:
              input.form-control(
                type="text"
                value=admision.Paciente ? `${admision.Paciente.nombre} ${admision.Paciente.apellido}` : ''
                readonly
              )

            //- Selección de cama (permite cambiar cama)
            .col-md-6
              label.form-label(for="cama_id") Cambiar Cama:
              select.form-select(name="cama_id" required)
                option(value="") Seleccione una cama...
                each cama in camas
                  option(
                    value=cama.id
                    selected=(cama.id === admision.cama_id)
                  )= `Cama ${cama.numero_cama} - Sala ${cama.Sala.numero_sala}`

          h5.mt-3 Datos de la Admisión
          .row.g-3
            //- Tipo de admisión editable
            .col-md-6
              label.form-label(for="tipo_admision") Tipo:
              select.form-select(name="tipo_admision" required)
                option(value="Programada" selected=(admision.tipo_admision === 'Programada')) Programada
                option(value="Emergencia" selected=(admision.tipo_admision === 'Emergencia')) Emergencia
                option(value="Derivada" selected=(admision.tipo_admision === 'Derivada')) Derivada

            //- Motivo editable
            .col-md-12
              label.form-label(for="motivo") Motivo:
              textarea.form-control(name="motivo" rows="3" required)= admision.motivo

          //- Botones de acción
          .mt-4
            button.btn.btn-primary(type="submit") Guardar Cambios
            a.btn.btn-secondary.ms-2(href="/admisiones") Cancelar
